{
  "manifest_version": 3,
  "name": "MSD One LLMs Extension",
  "version": "1.0",
  "description": "Scrape usage limits from LLM websites.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "*://claude.ai/*",
    "*://gemini.google.com/*",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://claude.ai/*",
        "*://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
