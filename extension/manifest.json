{
  "manifest_version": 3,
  "name": "MSD One LLMs Extension",
  "version": "1.0",
  "description": "Scrape usage limits from LLM websites.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "*://claude.ai/*",
    "*://gemini.google.com/*",
    "*://z.ai/*",
    "*://www.kimi.ai/*",
    "http://127.0.0.1:5001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://claude.ai/*",
        "*://gemini.google.com/*",
        "*://z.ai/*",
        "*://www.kimi.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true
    }
  ]
}
